{
	"admin": {
		"listen": "localhost:2019"
	},
	"apps": {
		"http": {
			"http_port": 8080,
			"servers": {
				"claude-proxy": {
					"listen": [":8080"],
					"automatic_https": {
						"disable": true
					},
					"routes": [
						{
							"match": [
								{
									"path": ["/v1/messages"],
									"method": ["POST"]
								}
							],
							"handle": [
								{
									"handler": "rewrite",
									"uri": "/v1/chat/completions"
								},
								{
									"handler": "claude2openai"
								},
								{
									"handler": "reverse_proxy",
									"upstreams": [
										{
											"dial": "api.openai.com:443"
										}
									]
								}
							]
						}
					]
				}
			}
		}
	}
}
